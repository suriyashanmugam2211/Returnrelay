# GROQ_API_KEY: Supported AI provider for conversational tool-calling agent
# Provide an API key from console.groq.com to use Groq models (e.g. llama-3.3-70b-versatile)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: The model identifier to use (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in AI Studio)
PORT=3000

# RETURNRELAY_DEMO_DATE: Fixed reference date for deterministic testing & simulation (ISO-8601: YYYY-MM-DD)
# Defaults to 2026-10-22
RETURNRELAY_DEMO_DATE="2026-10-22"
